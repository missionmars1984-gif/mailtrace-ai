# MailTrace Exchange Environment Configuration
PORT=5001

# SMTP Outbound Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Enterprise Mail <user@corp.local>"

# Inbound Mailbox Configuration (Mailpit REST API or IMAP)
MAILPIT_API_URL=http://localhost:8025

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURE=true

# MailTrace SOC Background Ingestion Bridge (Server-to-Server Only)
SOC_BACKEND_URL=http://localhost:5000/api/ingest/email
